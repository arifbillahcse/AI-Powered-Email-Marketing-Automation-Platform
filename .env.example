APP_NAME=OutreachAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# pgsql for Docker/VPS (docker-compose sets it), mysql for cPanel
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=outreach
DB_USERNAME=outreach
DB_PASSWORD=secret
# Read replicas (comma-separated). SELECTs go there; writes use DB_HOST.
# DB_READ_HOST=

# database works everywhere (cPanel). docker-compose switches these to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit catches everything (UI at http://localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Feature modules (see config/modules.php)
MODULE_AI_ENABLED=true
MODULE_WARMUP_ENABLED=true
MODULE_EMAIL_VERIFICATION_ENABLED=true
MODULE_API_ENABLED=true
MODULE_WHITE_LABEL_ENABLED=true
MODULE_MULTICHANNEL_ENABLED=true
MODULE_INBOX_PLACEMENT_ENABLED=true
MODULE_LEAD_FINDER_ENABLED=true

# Mailboxes: allow private hosts (e.g. Mailpit) for local dev only. Keep false in production.
MAILBOX_ALLOW_PRIVATE_HOSTS=true
MAILBOX_CONNECT_TIMEOUT=10

# Customers CNAME their tracking subdomain to this host. Defaults to track.<APP_URL host>.
# TRACKING_CNAME_TARGET=track.example.com

# Run queues from the every-minute cron instead of Horizon. Defaults to true
# when QUEUE_CONNECTION=database (cPanel); set false if you run queue workers.
# QUEUE_RUN_FROM_SCHEDULER=true

# OAuth apps for "Connect Google / Microsoft 365" mailboxes (optional).
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_CLIENT_ID=
# MICROSOFT_MAIL_CLIENT_SECRET=
# MICROSOFT_MAIL_TENANT=common

# Email verification service for mailbox-level checks (optional): millionverifier | zerobounce
# EMAIL_VERIFICATION_PROVIDER=
# EMAIL_VERIFICATION_API_KEY=

# SaaS billing (off = self-hosted, no plans or limits). See README "Billing".
BILLING_ENABLED=false
# BILLING_USD_TO_BDT=122
# BILLING_SELLER_NAME="Softorio"
# BILLING_SELLER_ADDRESS="House 12, Road 5, Dhaka 1207, Bangladesh"
# BILLING_MANUAL_INSTRUCTIONS="Transfer to City Bank, A/C 123456, then email the receipt."
# STRIPE_ENABLED=false
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# SSLCOMMERZ_ENABLED=false
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=true
# BKASH_ENABLED=false
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_SANDBOX=true

# Deliverability safety: pause a mailbox/campaign whose bounce or spam-complaint
# rate (percent, last 7 days) goes over these limits.
# AUTO_PAUSE_ENABLED=true
# AUTO_PAUSE_BOUNCE_RATE=5
# AUTO_PAUSE_COMPLAINT_RATE=0.3

# AI personalization ("Included AI credits"). Workspaces can also bring their own key.
ANTHROPIC_API_KEY=
AI_PLATFORM_MODEL=claude-opus-5-5
AI_PLATFORM_MONTHLY_TOKENS=2000000

# Lead finder (Hunter.io domain search), used for every workspace.
# HUNTER_API_KEY=

# Inbox placement tests: the workspace (slug or id) whose mailboxes are the seeds.
# PLACEMENT_SEED_WORKSPACE=

# Raw open/click events older than this many days move to gzipped files (0 = keep).
# ARCHIVE_EVENTS_AFTER_DAYS=180

# Horizon worker pools (VPS). Dedicated sending: Super admin → Workspaces.
# HORIZON_SENDING_PROCESSES=20
# HORIZON_SENDING_PRIORITY_PROCESSES=10
# HORIZON_IMAP_PROCESSES=10
