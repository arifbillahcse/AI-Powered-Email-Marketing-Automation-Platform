APP_NAME=OutreachAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# pgsql for Docker/VPS (docker-compose sets it), mysql for cPanel
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=outreach
DB_USERNAME=outreach
DB_PASSWORD=secret

# database works everywhere (cPanel). docker-compose switches these to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: Mailpit catches everything (UI at http://localhost:8025).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Feature modules (see config/modules.php)
MODULE_AI_ENABLED=true
MODULE_WARMUP_ENABLED=false
MODULE_EMAIL_VERIFICATION_ENABLED=false
MODULE_WHITE_LABEL_ENABLED=false

# Mailboxes: allow private hosts (e.g. Mailpit) for local dev only. Keep false in production.
MAILBOX_ALLOW_PRIVATE_HOSTS=true
MAILBOX_CONNECT_TIMEOUT=10

# Customers CNAME their tracking subdomain to this host. Defaults to track.<APP_URL host>.
# TRACKING_CNAME_TARGET=track.example.com

# Shared hosting (cPanel): run queues from the every-minute cron instead of Horizon.
QUEUE_RUN_FROM_SCHEDULER=false
